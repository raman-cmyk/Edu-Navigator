# Client-safe values only. Anything secret lives in Edge Function env, never here.
# See docs/03-architecture.md — "no API keys in the client".

VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key

# Optional, privacy-respecting. Analytics is cookieless (Plausible); both are
# no-ops when unset. No PII is ever sent.
# VITE_PLAUSIBLE_DOMAIN=baato.app
# VITE_SENTRY_DSN=

# --- Edge Function env (NOT prefixed with VITE_, never bundled) ---
# SUPABASE_SERVICE_ROLE_KEY=
# CLAUDE_API_KEY=
# VIBER_API_KEY=
# RESEND_API_KEY=
